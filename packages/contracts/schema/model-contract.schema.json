{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "physical",
        "ecological",
        "social",
        "economic",
        "policy",
        "stand-in"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "crs": {
            "type": "string"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "grid",
              "scalar",
              "table",
              "vector",
              "mask"
            ]
          },
          "grid": {
            "type": "object",
            "properties": {
              "resolution_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "extent": {
                "type": "string",
                "enum": [
                  "scope",
                  "segment",
                  "catchment",
                  "point",
                  "none"
                ]
              },
              "extent_rule": {
                "type": "string"
              }
            },
            "required": [
              "resolution_m",
              "extent",
              "extent_rule"
            ],
            "additionalProperties": false
          },
          "timestep": {
            "type": "string",
            "enum": [
              "none",
              "event",
              "hourly",
              "daily",
              "annual",
              "horizon"
            ]
          },
          "valid_range": {
            "type": "array",
            "items": [
              {
                "type": [
                  "number",
                  "null"
                ]
              },
              {
                "type": [
                  "number",
                  "null"
                ]
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "name",
          "quantity",
          "unit",
          "crs",
          "dtype",
          "grid",
          "timestep",
          "valid_range",
          "required",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "crs": {
            "type": "string"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "grid",
              "scalar",
              "table",
              "vector",
              "mask"
            ]
          },
          "grid": {
            "type": "object",
            "properties": {
              "resolution_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "extent": {
                "type": "string",
                "enum": [
                  "scope",
                  "segment",
                  "catchment",
                  "point",
                  "none"
                ]
              },
              "extent_rule": {
                "type": "string"
              }
            },
            "required": [
              "resolution_m",
              "extent",
              "extent_rule"
            ],
            "additionalProperties": false
          },
          "timestep": {
            "type": "string",
            "enum": [
              "none",
              "event",
              "hourly",
              "daily",
              "annual",
              "horizon"
            ]
          },
          "valid_range": {
            "type": "array",
            "items": [
              {
                "type": [
                  "number",
                  "null"
                ]
              },
              {
                "type": [
                  "number",
                  "null"
                ]
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "name",
          "quantity",
          "unit",
          "crs",
          "dtype",
          "grid",
          "timestep",
          "valid_range",
          "required",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "applicability": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "global",
              "national",
              "state",
              "city",
              "site"
            ]
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "levels",
        "conditions"
      ],
      "additionalProperties": false
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string"
          },
          "to_model": {
            "type": "string"
          },
          "to_input": {
            "type": "string"
          },
          "transform": {
            "type": "object",
            "properties": {
              "regrid": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "nearest",
                  "bilinear",
                  "aggregate_sum",
                  "aggregate_mean",
                  "aggregate_max"
                ]
              },
              "reproject": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_conversion": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "factor": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "from",
                      "to",
                      "factor"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "merge": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "max_water_level",
                  "sum",
                  "mean"
                ]
              },
              "timestep": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "event_to_annual_trapezoid",
                  "hourly_to_event_max"
                ]
              },
              "aggregation": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "sum",
                  "mean",
                  "max",
                  "count"
                ]
              },
              "note": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "regrid",
              "reproject",
              "unit_conversion",
              "merge",
              "timestep",
              "aggregation",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "output",
          "to_model",
          "to_input",
          "transform"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "band",
            "ensemble",
            "class"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "uncalibrated",
            "calibrated",
            "signed_off"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "metrics": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "note": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "event",
              "date",
              "metrics",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "signed_off_by": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "signed_off_at": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "events",
        "signed_off_by",
        "signed_off_at"
      ],
      "additionalProperties": false
    },
    "registry_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "runner",
        "retries",
        "timeout_s"
      ],
      "additionalProperties": false
    },
    "grounding": {
      "type": "string",
      "enum": [
        "solid_direct",
        "reasoned_extrapolation",
        "placeholder_needs_calibration"
      ]
    },
    "description": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "inputs",
    "outputs",
    "applicability",
    "routing",
    "uncertainty",
    "calibration",
    "registry_dependencies",
    "agent",
    "grounding",
    "description"
  ],
  "additionalProperties": false
}
